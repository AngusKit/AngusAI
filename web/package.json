{
  "name": "AngusAI",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "vite build",
    "openapi-ts": "openapi-ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "type-check": "tsc --noEmit",
    "dev": "vite --mode dev",
    "dev:env": "husky install && NODE_OPTIONS=--max-old-space-size=8192 node scripts/build.js",
    "dev:dev": "husky install && NODE_OPTIONS=--max-old-space-size=8192 node ./scripts/build.js -- --env=dev --edition_type=CLOUD_SERVICE",
    "dev:prod": "husky install && NODE_OPTIONS=--max-old-space-size=8192 node ./scripts/build.js -- --env=prod --edition_type=CLOUD_SERVICE",
    "dev:priv:community": "husky install && NODE_OPTIONS=--max-old-space-size=8192 node scripts/build.js -- --env=priv --edition_type=COMMUNITY",
    "dev:priv:enterprise": "husky install && NODE_OPTIONS=--max-old-space-size=8192 node scripts/build.js -- --env=priv --edition_type=ENTERPRISE",
    "dev:priv:datacenter": "husky install && NODE_OPTIONS=--max-old-space-size=8192 node scripts/build.js -- --env=priv --edition_type=DATACENTER",
    "build:env": "NODE_OPTIONS=--max-old-space-size=8192 node ./scripts/build.js",
    "build:dev": "NODE_OPTIONS=--max-old-space-size=8192 node ./scripts/build.js -- --env=dev --edition_type=CLOUD_SERVICE",
    "build:prod": "NODE_OPTIONS=--max-old-space-size=8192 node ./scripts/build.js -- --env=prod --edition_type=CLOUD_SERVICE",
    "build:priv:community": "NODE_OPTIONS=--max-old-space-size=8192 node ./scripts/build.js -- --env=priv --edition_type=COMMUNITY",
    "build:priv:enterprise": "NODE_OPTIONS=--max-old-space-size=8192 node ./scripts/build.js -- --env=priv --edition_type=ENTERPRISE",
    "build:priv:datacenter": "NODE_OPTIONS=--max-old-space-size=8192 node ./scripts/build.js -- --env=priv --edition_type=DATACENTER",
    "vite:build:dev": "vite build --mode dev",
    "vite:build:prod": "vite build --mode prod",
    "vite:build:priv": "vite build --mode priv"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-aspect-ratio": "^1.1.2",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.3",
    "@radix-ui/react-context-menu": "^2.2.6",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-hover-card": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-menubar": "^1.1.6",
    "@radix-ui/react-navigation-menu": "^1.2.5",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toggle": "^1.1.2",
    "@radix-ui/react-toggle-group": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@xcan-angus/infra": "^2.0.0",
    "axios": "^1.13.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "*",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "highlight.js": "^11.11.1",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.487.0",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.55.0",
    "react-markdown": "^9.1.0",
    "react-resizable-panels": "^2.1.7",
    "react-router-dom": "^7.13.1",
    "reactflow": "*",
    "recharts": "^2.15.2",
    "rehype-highlight": "^7.0.2",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "*",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react-swc": "^3.10.2",
    "babel-jest": "^30.2.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "prettier": "^3.4.2",
    "prettier-plugin-one-line-imports": "^1.0.1",
    "swagger-typescript-api": "^13.2.16",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  }
}
